#!/bin/bash
set -euo pipefail

# Proxmox Ubuntu Resolute template builder — remote-capable wrapper.
#
# Two modes:
#
#   1. REMOTE (curl pipe) — downloads latest files, no clone needed:
#        bash <(curl -fsSL https://raw.githubusercontent.com/dbensmith/home-ops-bootstrap/main/build-ubuntu-resolute-template)
#
#   2. LOCAL (cloned repo) — uses local proxmox/ files:
#        ./build-ubuntu-resolute-template
#
# 1Password CLI: https://1password.com/downloads/command-line/
#
# 1Password auth (one required):
#   eval $(op signin)                       # interactive (or: op signin -f)
#   export OP_SERVICE_ACCOUNT_TOKEN=...    # headless/CI
#
# Your .env.tpl needs op:// references for SSHKEY, NS1, NS2, SEARCHDOMAIN.
# Fork the repo and update proxmox/build-ubuntu-resolute-template.env.tpl
# with your own 1Password vault items.

REPO="dbensmith/home-ops-bootstrap"
BRANCH="main"
BASE_URL="https://raw.githubusercontent.com/$REPO/$BRANCH"

# --- Find script files: local checkout or remote download ---
__dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd 2>/dev/null || pwd)"

if [ -f "$__dir/proxmox/build-ubuntu-resolute-template.sh" ]; then
    # Local mode — use files from repo checkout
    TPL_FILE="$__dir/proxmox/build-ubuntu-resolute-template.env.tpl"
    SCRIPT_FILE="$__dir/proxmox/build-ubuntu-resolute-template.sh"
else
    # Remote mode — download latest from GitHub
    WORKDIR=$(mktemp -d)
    trap 'rm -rf "$WORKDIR"' EXIT

    echo "Downloading template builder from $REPO..."
    curl -fsSL -o "$WORKDIR/build-ubuntu-resolute-template.sh" \
        "$BASE_URL/proxmox/build-ubuntu-resolute-template.sh"
    curl -fsSL -o "$WORKDIR/sysprep-ubuntu-resolute-template.sh" \
        "$BASE_URL/proxmox/sysprep-ubuntu-resolute-template.sh"
    curl -fsSL -o "$WORKDIR/build-ubuntu-resolute-template.env.tpl" \
        "$BASE_URL/proxmox/build-ubuntu-resolute-template.env.tpl"

    chmod +x "$WORKDIR"/*.sh
    TPL_FILE="$WORKDIR/build-ubuntu-resolute-template.env.tpl"
    SCRIPT_FILE="$WORKDIR/build-ubuntu-resolute-template.sh"
fi

# --- Pre-flight checks ---
if ! command -v virt-customize &>/dev/null; then
    echo "libguestfs-tools (virt-customize) not found — required to customize the cloud image."
    read -r -p "Install libguestfs-tools? [Y/n] " REPLY
    case "${REPLY:-Y}" in
        y|Y|yes|YES|"") apt-get update && apt-get install -y libguestfs-tools ;;
        *) echo "Aborting. Install manually: apt-get install libguestfs-tools" >&2; exit 1 ;;
    esac
fi

if ! command -v op &>/dev/null; then
    echo "Error: 1Password CLI ('op') is not installed or not in PATH." >&2
    echo "Install from: https://1password.com/downloads/command-line/" >&2
    exit 1
fi

if ! op whoami &>/dev/null; then
    _sa_ok="[ -n \"${OP_SERVICE_ACCOUNT_TOKEN:-}\" ]"
    _connect_pair_ok="[ -n \"${OP_CONNECT_TOKEN_ENV:-}\" ] && [ -n \"${OP_CONNECT_HOST_ENV:-}\" ]"
    _connect_local_ok="[ -n \"${OP_CONNECT_TOKEN:-}\" ] && [ -n \"${OP_CONNECT_HOST:-}\" ]"
    if ! eval "$_sa_ok || $_connect_pair_ok || $_connect_local_ok"; then
        echo "Error: No 1Password authentication available." >&2
        if [[ "${CI:-}" == "true" ]]; then
            echo "In CI, set: OP_SERVICE_ACCOUNT_TOKEN" >&2
            echo "  or both: OP_CONNECT_HOST_ENV + OP_CONNECT_TOKEN_ENV" >&2
        else
            echo "For local dev, sign in first:  eval \$(op signin)" >&2
            echo "Or set: OP_SERVICE_ACCOUNT_TOKEN" >&2
            echo "  or both: OP_CONNECT_HOST + OP_CONNECT_TOKEN" >&2
        fi
        exit 1
    fi
fi

if [[ ! -f "$TPL_FILE" ]]; then
    echo "Error: env template not found: $TPL_FILE" >&2
    exit 1
fi

if [[ ! -f "$SCRIPT_FILE" ]]; then
    echo "Error: builder script not found: $SCRIPT_FILE" >&2
    exit 1
fi

# --- Execute ---
echo "Resolving secrets and building template..."
op run --env-file="$TPL_FILE" -- "$SCRIPT_FILE" "$@"
